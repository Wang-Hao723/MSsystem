    "forbidden_provenance_tokens": [
      "search_result",
      "library_top1",
      "predicted_identity",
      "candidate_ranking"
    ],
    "require_nonempty_standard_lot": true
  },
  "leakage": {
    "fail_on_connectivity_overlap": true,
    "fail_on_exact_isomeric_smiles_overlap": true,
