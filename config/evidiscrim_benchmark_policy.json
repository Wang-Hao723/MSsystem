{
  "schema_version": "1.0.0",
  "policy_id": "evidiscrim-ms-identity-disjoint-benchmark-v1.0.0-20260807",
  "study_state": "locally_locked_protocol_awaiting_authentic_standard_manifest_and_external_timestamp",
  "random_seed": 20260807,
  "split": {
    "unit": "rdkit_connectivity_candidate_graph_component",
