    "remove_precursor_peak": false,
    "modified_cosine_mass_shift": false
  },
  "qtof_calibration": {
    "method": "identity_disjoint_domain_specific_isotonic_peak_intensity_transfer",
    "base_architecture_family_preserved": true,
    "counts_as_independent_architecture": false,
    "require_qtof_analyzer": true,
    "require_exact_vendor_model_activation_polarity_adduct_energy_unit": true,
    "allow_collision_energy_interpolation": false,
    "allow_cross_instrument_transfer": false,
    "minimum_connectivity_identities_per_domain": 20,
    "minimum_predicted_peaks_per_domain": 200,
    "out_of_bounds": "clip"
