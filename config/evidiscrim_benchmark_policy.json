    "equal_weight_architecture_families": true,
    "same_architecture_checkpoints_are_within_family_replicates": true,
    "singleton_uncertainty_floor_allowed": false,
    "single_architecture_pair_resolution_allowed": false,
    "architecture_family_registry": {
