      "3dmolms_3d_conformation_gnn": {
        "independence_group": "three_dimensional_conformation_message_passing",
        "reference_instrument_domain": "QTOF"
      }
    },
    "require_model_artifact_sha256_for_every_declared_family": true
  },
  "comparisons": {
    "required_methods": [
