{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mssystem.local/schemas/feature-fragment-public-spectrum-v3.json",
  "title": "Mssystem V15 instrument-conditioned public spectrum V3",
  "type": "object",
  "required": [
    "schema_version",
    "spectrum_id",
    "evidence_stage",
    "identification_scope",
    "source",
    "compound",
    "acquisition",
    "raw_acquisition",
    "independence",
    "metadata_completeness",
    "quantitative_eligibility",
    "peaks"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "spectrum_id": {"type": "string", "minLength": 1},
    "evidence_stage": {"const": "raw_msms_spectrum"},
    "source": {
      "type": "object",
      "required": ["repository", "repository_release", "source_id", "origin_dataset_id", "origin_study_id", "laboratory_id", "accession", "record_url", "license", "source_file_sha256", "record_canonical_json_sha256"],
      "properties": {
        "license": {
          "type": "object",
          "required": ["label", "tier", "license_url", "attribution", "rights_holder", "record_literal_preserved"]
        }
      }
    },
    "compound": {
      "type": "object",
      "required": ["display_name", "inchikey", "connectivity", "formula", "identity_basis", "reference_material_claim", "standard_confirmation_status", "chemical_class"]
    },
    "acquisition": {
      "type": "object",
      "required": ["instrument_vendor", "instrument_model", "analyzer", "activation", "activation_location", "collision_cell_region", "instrument_domain_id", "collision_energy", "scan_range", "polarity", "adduct", "charge", "precursor_mz", "precursor_isolation"]
    },
    "raw_acquisition": {
      "type": "object",
      "required": ["raw_file_id", "scan_id", "injection_id", "acquisition_event_id"]
    },
    "independence": {
      "type": "object",
      "required": ["two_dimensional_identity_id", "formula_family_id", "source_origin_id", "laboratory_id", "exact_peak_hash", "mirror_cluster_id", "acquisition_replication_group_id", "peak_hash_used_in_acquisition_replication_group", "fragment_pathway_group_id"]
    },
    "metadata_completeness": {
      "type": "object",
      "required": ["fields", "missing_fields", "complete_field_count", "field_count"]
    },
    "quantitative_eligibility": {
      "type": "object",
      "required": ["primary_license_eligible", "range_contains_precursor", "precursor_selection_verified", "verified_single_compound_reference_acquisition", "positive_lr_eligible", "negative_lr_eligible", "positive_only_composite_or_in_source", "ineligible_reason_codes"]
    },
    "peaks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
