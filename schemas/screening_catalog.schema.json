{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mssystem.local/schemas/screening_catalog.schema.json",
  "title": "MSsystem identity-first screening catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "released_at", "activation_policy", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "released_at": {"type": "string", "format": "date"},
    "purpose": {"type": "string"},
    "activation_policy": {
      "type": "object",
      "required": ["primary_key", "name_matching_allowed", "mass_only_activation_allowed", "regulatory_claims_encoded"],
      "properties": {
        "primary_key": {"const": "full_inchikey"},
        "name_matching_allowed": {"const": false},
        "mass_only_activation_allowed": {"const": false},
        "regulatory_claims_encoded": {"const": false},
        "spectral_confirmation_implied": {"const": false}
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "canonical_name", "full_inchikey", "formula", "smiles",
          "compound_role", "screening_domain", "contaminant_category",
          "regulatory_status", "identity_source"
        ],
        "properties": {
          "canonical_name": {"type": "string", "minLength": 1},
          "name_cn": {"type": "string"},
          "full_inchikey": {"type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"},
          "alternate_full_inchikeys": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z]{14}-[A-Z]{10}-[A-Z]$"}
          },
          "formula": {"type": "string", "minLength": 1},
          "smiles": {"type": "string", "minLength": 1},
          "pubchem_cid": {"type": "integer", "minimum": 1},
          "compound_role": {
            "enum": [
              "pesticide_screening_target", "environmental_contaminant",
              "industrial_contaminant", "transformation_product"
            ]
          },
          "screening_domain": {"type": "string", "minLength": 1},
          "pesticide_use": {"type": "string"},
          "chemical_family": {"type": "string"},
          "contaminant_category": {"type": "string", "minLength": 1},
          "regulatory_status": {"const": "not_encoded"},
          "identity_source": {"type": "string", "format": "uri", "pattern": "^https://"},
          "note_cn": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
